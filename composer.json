{
    "name": "duncanmcclean/statamic-cloudflare-static-cache",
    "description": "A static caching strategy for Statamic that keeps your pages in Cloudflare's cache.",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "DuncanMcClean\\CloudflareStaticCache\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Cloudflare Static Cache",
            "description": "A static caching strategy for Statamic that keeps your pages in Cloudflare's cache."
        },
        "laravel": {
            "providers": [
                "DuncanMcClean\\CloudflareStaticCache\\ServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.42"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.8 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
